{
  "name": "ketcher-desktop",
  "productName": "Ketcher Desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron-обёртка для Ketcher",
  "main": "main.js",
  "scripts": {
    "prestart": "npm run build:renderer",
    "start": "electron .",
    "dev:renderer": "vite --config renderer/vite.config.js",
    "build:renderer": "vite build --config renderer/vite.config.js",
    "dist": "npm run build:renderer && electron-builder --mac",
    "ketcher:dev": "npm --prefix ketcher/example run dev:standalone",
    "icon": "node scripts/make-icon.mjs"
  },
  "build": {
    "appId": "com.moleculadesigner.ketcherdesktop",
    "productName": "Ketcher Desktop",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "error.html",
      "renderer/dist/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    }
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "events": "^3.3.0",
    "ketcher-react": "^3.18.0",
    "ketcher-standalone": "^3.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^8.3.6"
  },
  "author": {
    "name": "moleculadesigner"
  }
}
